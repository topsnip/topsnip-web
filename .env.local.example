# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI image generation
OPENAI_API_KEY=sk-...

# YouTube Data API v3
# Used for video search and metadata only. Do not scrape transcripts.
YOUTUBE_API_KEY=AIza...

# GitHub (optional)
# Personal access token for higher GitHub API rate limits.
GITHUB_TOKEN=ghp_...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cron Authentication
# Shared secret for Vercel Cron and pipeline API routes.
CRON_SECRET=your-cron-secret-here

# Upstash Redis quota/rate backing
# Required in production for durable cost caps.
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org
SENTRY_PROJECT=topsnip

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend (optional)
RESEND_API_KEY=re_...
FROM_EMAIL=TopSnip <noreply@topsnip.co>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
