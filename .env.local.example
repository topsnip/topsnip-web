# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI image generation
OPENAI_API_KEY=sk-...

# Upstash Redis quota/rate backing. Required in production for durable cost caps.
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ── YouTube Data API v3 ────────────────────────────────────────────────────
# Used for video search + metadata
# Get from: https://console.cloud.google.com/ → Enable YouTube Data API v3
YOUTUBE_API_KEY=AIza...

# ── GitHub (optional) ─────────────────────────────────────────────────────
# Personal access token for higher GitHub API rate limits (5000/hr vs 60/hr)
# Get from: https://github.com/settings/tokens → Fine-grained token (read-only)
GITHUB_TOKEN=ghp_...

# ── Supabase ───────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# IMPORTANT: Use test keys for dev, live keys for prod — never mix them
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...    # $9.99/mo
STRIPE_PRO_YEARLY_PRICE_ID=price_...     # $79/year

# ── Cron Authentication ──────────────────────────────────────────────────
# Shared secret for Vercel Cron → /api/ingest/* routes
CRON_SECRET=your-cron-secret-here

# ── IP Hash Salt (optional) ─────────────────────────────────────────────
# Separate salt for privacy-preserving IP hashing in anonymous search tracking
# Falls back to CRON_SECRET if not set
# IP_HASH_SALT=your-ip-hash-salt-here

# ── Sentry ──────────────────────────────────────────────────────────────
# Get from: https://sentry.io → Project Settings → Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=sntrys_...        # For source map uploads (CI only)
# SENTRY_ORG=your-org
# SENTRY_PROJECT=topsnip

# ── PostHog ─────────────────────────────────────────────────────────────
# Get from: https://us.posthog.com → Project Settings → Project API Key
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Resend (transactional email) ──────────────────────────────────────────
# Get from: https://resend.com/api-keys
# Gracefully no-ops if not set (emails silently skipped)
# RESEND_API_KEY=re_...
# FROM_EMAIL=TopSnip <noreply@topsnip.co>

# ── App ───────────────────────────────────────────────────────────────────
# Must match your Vercel deployment URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
